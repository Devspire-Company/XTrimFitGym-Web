# Copy this file to ".env" in the project root and fill in values.
# For the same attendance/users as Vercel production, use the SAME API + Clerk as production (not localhost unless your API runs there).

VITE_GRAPHQL_URL=https://xtrimfitgym-api.onrender.com/graphql
VITE_GRAPHQL_WS_URL=wss://xtrimfitgym-api.onrender.com/graphql

# Must match the Clerk instance your Render API validates (pk_test_… vs pk_live_…).
VITE_CLERK_PUBLISHABLE_KEY=
