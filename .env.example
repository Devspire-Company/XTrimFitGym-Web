# GraphQL API endpoint. Must include /graphql path.
# Local: run API locally and use http://localhost:8000/graphql (this default is used if you leave it unset in dev).
# Production (Vercel): set to your deployed API URL + /graphql, e.g.:
#   VITE_GRAPHQL_URL=https://xtrimfitgym-api.onrender.com/graphql
VITE_GRAPHQL_URL=http://localhost:8000/graphql

# WebSocket URL for subscriptions (optional). If unset, derived from VITE_GRAPHQL_URL.
# VITE_GRAPHQL_WS_URL=wss://xtrimfitgym-api.onrender.com/graphql
